# Supabase Project Settings > API (use a dedicated project if possible)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend only; never expose in NEXT_PUBLIC_ variables
SUPABASE_SERVICE_ROLE_KEY=

# Stripe sandbox restricted secret key, and webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Set to your real HTTPS preview/production URL
NEXT_PUBLIC_SITE_URL=https://your-prezzstore-domain.example
# Default platform commission: 8%. Change only after reviewing payment costs.
PREZZ_PLATFORM_FEE_BPS=800
# US only for initial v2 Connect onboarding; see README
STRIPE_CONNECT_COUNTRY=us